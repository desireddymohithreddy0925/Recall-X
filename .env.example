# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/recallx?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# JPA Configuration
JPA_SHOW_SQL=true

# Security Secrets (Do not commit real values)
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough
JWT_EXPIRATION_MS=86400000

# AI Configuration
CLAUDE_API_KEY=your_claude_api_key

# Hindsight Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key
HINDSIGHT_URL=https://api.hindsight.example.com
